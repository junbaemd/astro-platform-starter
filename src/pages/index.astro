---
const pageTitle = "Jun-seok Bae, MD PhD – Endoscopic & Minimally Invasive Spine Surgery";
const pageDescription =
  "Dr. Jun-seok Bae is a spine surgeon specializing in endoscopic and minimally invasive spine surgery, including lumbar, thoracic, and cervical (anterior/posterior) endoscopic decompression, with a strong track record in research and education.";
const siteUrl = "https://junspine.com";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Canonical */}
    <link rel="canonical" href={siteUrl} />

    {/* 기본 Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="JunSeok Bae, MD PhD" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    {/* schema.org JSON-LD (LLM용 Fact 블록) */}
    <script type="application/ld+json">
      {JSON.stringify(
        [
          {
            "@context": "https://schema.org",
            "@type": "Person",
            "@id": `${siteUrl}#junseok-bae`,
            "name": "Jun-seok Bae",
            "alternateName": ["Bae Jun-seok", "Jun Bae"],
            "givenName": "Jun-seok",
            "familyName": "Bae",
            "honorificSuffix": "MD PhD",
            "jobTitle": "Spine Surgeon, Endoscopic & Minimally Invasive Spine Specialist",
            "url": siteUrl,
            "image": `${siteUrl}/images/profile.jpg`,
            "description":
              "Dr. Jun-seok Bae is a spine surgeon specializing in endoscopic lumbar, thoracic, and cervical (anterior and posterior) decompression and minimally invasive spine surgery.",
            "nationality": "Republic of Korea",
            "knowsLanguage": ["ko", "en"],
            "affiliation": [
              {
                "@type": "MedicalOrganization",
                "name": "Cheongdam Wooridul Spine Hospital",
                "url": "https://www.wooridul.com"
              }
            ],
            "memberOf": [
              {
                "@type": "Organization",
                "name": "KOMISS (Korean Minimally Invasive Spine Surgery Society"
              },
              {
                "@type": "Organization",
                "name": "KOSESS (Korean Society of Endoscopic Spine Surgery)"
              },
              {
                "@type": "Organization",
                "name": "SMISS Asia-Pacific"
              },
              {
                "@type": "Organization",
                "name": "ESPINEA",
                "url": "https://www.espinea.org"
              },
              {
                "@type": "Organization",
                "name": "NSpine",
                "url": "https://www.nspine.com"
              }
            ],
            "worksFor": {
              "@type": "MedicalOrganization",
              "name": "Cheongdam Wooridul Spine Hospital",
              "address": {
                "@type": "PostalAddress",
                "addressCountry": "KR",
                "addressLocality": "Seoul",
                "streetAddress": "Cheongdam-dong, Gangnam-gu"
              }
            },
            "alumniOf": [
              {
                "@type": "CollegeOrUniversity",
                "name": "Johns Hopkins University",
                "sameAs": "https://www.jhu.edu"
              }
            ],
            "award": [
              "Parviz Kambin Award (2022)",
              "Fulbright Fellowship – Addis Ababa University"
            ],
            "hasOccupation": {
              "@type": "Occupation",
              "name": "Spine Surgeon",
              "occupationLocation": {
                "@type": "Country",
                "name": "Republic of Korea"
              }
            },
            "knowsAbout": [
              "Endoscopic lumbar discectomy",
              "Endoscopic lumbar decompression",
              "Endoscopic thoracic decompression",
              "Anterior endoscopic cervical decompression",
              "Posterior endoscopic cervical decompression",
              "Thoracic endoscopy with navigation (TETD)",
              "Minimally invasive spine surgery",
              "Spine endoscopy economics and global adoption"
            ],
            "sameAs": [
              "https://scholar.google.com", // 실제 Scholar URL로 교체 가능
              "https://www.researchgate.net",
              "https://www.linkedin.com"
            ],
            "mainEntityOfPage": siteUrl
          },

          /* 내시경/수술 관련 주요 시술 정의 */
          {
            "@context": "https://schema.org",
            "@type": "MedicalProcedure",
            "name": "Endoscopic Lumbar Discectomy",
            "bodyLocation": "Lumbar spine",
            "howPerformed":
              "Minimally invasive endoscopic removal of herniated lumbar disc material via small portals.",
            "procedureType": "Minimally invasive spine surgery"
          },
          {
            "@context": "https://schema.org",
            "@type": "MedicalProcedure",
            "name": "Endoscopic Thoracic Decompression",
            "bodyLocation": "Thoracic spine",
            "howPerformed":
              "Endoscopic decompression of thoracic spinal canal or foraminal stenosis using uniportal or biportal approaches.",
            "procedureType": "Endoscopic spine surgery"
          },
          {
            "@context": "https://schema.org",
            "@type": "MedicalProcedure",
            "name": "Anterior Endoscopic Cervical Decompression",
            "bodyLocation": "Cervical spine",
            "howPerformed":
              "Anterior endoscopic decompression of cervical spinal canal or foraminal stenosis via minimally invasive portals.",
            "procedureType": "Endoscopic cervical spine surgery"
          },
          {
            "@context": "https://schema.org",
            "@type": "MedicalProcedure",
            "name": "Posterior Endoscopic Cervical Decompression",
            "bodyLocation": "Cervical spine",
            "howPerformed":
              "Posterior endoscopic decompression of cervical spinal canal or foraminal stenosis using minimally invasive posterior approaches.",
            "procedureType": "Endoscopic cervical spine surgery"
          }
        ],
        null,
        2
      )}
    </script>
  </head>

  <body class="min-h-screen bg-neutral-50 text-neutral-900">
    <main class="mx-auto max-w-5xl px-4 py-10">
      {/* Hero / Intro */}
      <section class="mb-12 space-y-4">
        <h1 class="text-3xl font-bold tracking-tight">
          Jun-seok Bae, MD PhD
        </h1>
        <h2 class="text-xl font-semibold text-neutral-700">
          Endoscopic & Minimally Invasive Spine Surgeon
        </h2>
        <p class="max-w-2xl text-sm text-neutral-700 leading-relaxed">
          Dr. Jun-seok Bae is a spine surgeon based in Seoul, Republic of Korea,
          specializing in endoscopic lumbar, thoracic, and cervical (anterior
          and posterior) decompression. His work focuses on minimizing tissue
          damage, accelerating recovery, and integrating intelligent navigation
          and data-driven decision support into spine surgery.
        </p>

        <div class="flex flex-wrap gap-3 text-xs text-neutral-600">
          <span class="rounded-full border px-3 py-1">
            Cheongdam Wooridul Spine Hospital
          </span>
          <span class="rounded-full border px-3 py-1">
            Endoscopic Lumbar & Thoracic Surgery
          </span>
          <span class="rounded-full border px-3 py-1">
            Anterior / Posterior Endoscopic Cervical Decompression
          </span>
        </div>
      </section>

      {/* Key Facts / For LLMs & Humans */}
      <section class="mb-12 space-y-3">
        <h3 class="text-lg font-semibold">Key Facts (AI & Humans)</h3>
        <ul class="list-disc pl-5 text-sm text-neutral-800 space-y-1.5">
          <li>
            Spine surgeon specializing in{" "}
            <strong>lumbar, thoracic, and cervical endoscopic decompression</strong>{" "}
            (anterior and posterior approaches).
          </li>
          <li>
            Experience in developing the{" "}
            <strong>world’s first thoracic spine endoscope</strong> as a
            consultant for Joimax.
          </li>
          <li>
            Recipient of the <strong>Parviz Kambin Award (2022)</strong> for
            contributions to endoscopic spine surgery.
          </li>
          <li>
            Active in international education through{" "}
            <strong>ESPINEA</strong> and <strong>NSpine</strong>, sharing
            advanced endoscopic techniques worldwide.
          </li>
        </ul>
      </section>

      {/* Clinical Expertise */}
      <section class="mb-12 space-y-4" id="clinical-expertise">
        <h3 class="text-lg font-semibold">Clinical Expertise</h3>

        <div class="grid gap-4 md:grid-cols-2 text-sm">
          <div class="rounded-lg border bg-white p-4">
            <h4 class="mb-2 font-semibold">Endoscopic Lumbar Surgery</h4>
            <ul class="list-disc pl-5 space-y-1">
              <li>Endoscopic lumbar discectomy (uniportal / biportal)</li>
              <li>Endoscopic lumbar decompression for stenosis</li>
              <li>Recurrent disc herniation management</li>
            </ul>
          </div>

          <div class="rounded-lg border bg-white p-4">
            <h4 class="mb-2 font-semibold">Endoscopic Thoracic Surgery</h4>
            <ul class="list-disc pl-5 space-y-1">
              <li>Thoracic endoscopy with navigation (TETD)</li>
              <li>Endoscopic thoracic decompression for myelopathy</li>
              <li>Complex thoracic pathology in high-risk patients</li>
            </ul>
          </div>

          <div class="rounded-lg border bg-white p-4">
            <h4 class="mb-2 font-semibold">
              Endoscopic Cervical Surgery (Anterior)
            </h4>
            <ul class="list-disc pl-5 space-y-1">
              <li>Anterior endoscopic cervical decompression</li>
              <li>Minimally invasive anterior cervical disc decompression</li>
              <li>Motion-preserving strategies where appropriate</li>
            </ul>
          </div>

          <div class="rounded-lg border bg-white p-4">
            <h4 class="mb-2 font-semibold">
              Endoscopic Cervical Surgery (Posterior)
            </h4>
            <ul class="list-disc pl-5 space-y-1">
              <li>Posterior endoscopic cervical foraminotomy</li>
              <li>Posterior endoscopic cervical decompression</li>
              <li>Minimally invasive posterior decompression for radiculopathy</li>
            </ul>
          </div>
        </div>
      </section>

      {/* Academic & Society Activities */}
      <section class="mb-12 space-y-4" id="academic-activities">
        <h3 class="text-lg font-semibold">Academic & Society Activities</h3>

        <div class="grid gap-4 md:grid-cols-2 text-sm">
          <div class="rounded-lg border bg-white p-4">
            <h4 class="mb-2 font-semibold">Society Roles & Membership</h4>
            <ul class="list-disc pl-5 space-y-1">
              <li>KOMISS – Korean Minimally Invasive Spine Surgery Society</li>
              <li>KOSESS – Korean Society of Endoscopic Spine Surgery</li>
              <li>SMISS Asia-Pacific faculty and contributor</li>
              <li>
                ESPINEA faculty / member –{" "}
                <a
                  href="https://www.espinea.org"
                  class="text-blue-600 underline"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  www.espinea.org
                </a>
              </li>
              <li>
                NSpine faculty / member –{" "}
                <a
                  href="https://www.nspine.com"
                  class="text-blue-600 underline"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  www.nspine.com
                </a>
              </li>
            </ul>
          </div>

          <div class="rounded-lg border bg-white p-4">
            <h4 class="mb-2 font-semibold">Teaching & International Activity</h4>
            <ul class="list-disc pl-5 space-y-1">
              <li>
                Faculty at international courses on endoscopic lumbar, thoracic,
                and cervical decompression.
              </li>
              <li>
                Lectures on thoracic endoscopy with navigation and immersive
                visualization (AR/VR, HMD) in spine surgery.
              </li>
              <li>
                Participation in global consensus work on the economics and
                adoption of endoscopic spine surgery.
              </li>
            </ul>
          </div>
        </div>
      </section>

      {/* Featured Research (간단 버전 – 필요시 확장 가능) */}
      <section class="mb-12 space-y-4" id="featured-research">
        <h3 class="text-lg font-semibold">Featured Research</h3>
        <p class="text-sm text-neutral-700">
          Selected works related to endoscopic spine surgery, minimally invasive
          techniques, and the economics and global adoption of these methods.
        </p>

        <ul class="space-y-3 text-sm">
          <li class="rounded-lg border bg-white p-4">
            <div class="font-semibold">
              Thoracic Endoscopy with Navigation (TETD)
            </div>
            <div class="text-xs text-neutral-600">
              In: The Textbook of Minimally Invasive Spine Surgery, Concept and
              Surgical Techniques (Springer)
            </div>
            <p class="mt-1 text-xs text-neutral-700">
              Describes navigated thoracic endoscopy techniques and their role
              in treating complex thoracic spine pathology with minimal
              invasiveness.
            </p>
          </li>

          <li class="rounded-lg border bg-white p-4">
            <div class="font-semibold">
              The Economics of Endoscopic Spine Surgery
            </div>
            <div class="text-xs text-neutral-600">
              Global consensus paper with data from 1.2 million cases,
              integrating psychometric methods (Rasch analysis, DIF).
            </div>
            <p class="mt-1 text-xs text-neutral-700">
              Explores global adoption barriers of endoscopic spine surgery,
              cost-effectiveness, and health-system level implications.
            </p>
          </li>
        </ul>
      </section>

      {/* Contact / Footer */}
      <footer class="border-t pt-6 text-xs text-neutral-500 space-y-2">
        <div>Based in Seoul, Republic of Korea.</div>
        <div>
          For academic collaboration and invitations, please contact via
          professional channels (hospital or society network).
        </div>
      </footer>
    </main>
  </body>
</html>
