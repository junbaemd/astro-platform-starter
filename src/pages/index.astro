---
const pageTitle =
  "Junseok Bae, MD – Endoscopic & Minimally Invasive Spine Surgeon";
const pageDescription =
  "Dr. Junseok Bae is a spine surgeon specializing in endoscopic lumbar, thoracic, and cervical (anterior and posterior) decompression, minimally invasive spine surgery, and data-driven clinical decision support.";
const siteUrl = "https://junspine.com";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={siteUrl} />

    <!-- 기본 스타일: 외부 CSS / Tailwind 사용 안 함 -->
    <style>
      :root {
        --bg: #f5f5f7;
        --surface: #ffffff;
        --border: #e0e0e5;
        --text-main: #111827;
        --text-muted: #4b5563;
        --accent: #2563eb;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        background: var(--bg);
        color: var(--text-main);
      }
      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      .page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 32px 16px 40px;
      }
      header {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 32px;
      }
      .brand-title {
        font-size: 18px;
        font-weight: 600;
      }
      .brand-sub {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 4px;
      }
      nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 12px;
      }
      nav a {
        padding: 4px 0;
      }
      h1 {
        font-size: 28px;
        margin: 0 0 8px;
      }
      h2 {
        font-size: 20px;
        margin: 0 0 12px;
        color: var(--text-muted);
        font-weight: 600;
      }
      h3 {
        font-size: 18px;
        margin: 0 0 12px;
        font-weight: 600;
      }
      h4 {
        font-size: 14px;
        margin: 0 0 8px;
        font-weight: 600;
      }
      p {
        font-size: 14px;
        line-height: 1.6;
        margin: 0;
      }
      .section {
        margin-bottom: 40px;
      }
      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
      }
      .chip {
        border-radius: 999px;
        border: 1px solid var(--border);
        padding: 4px 12px;
        font-size: 11px;
        color: var(--text-muted);
        background: #ffffff;
      }
      .list {
        margin: 0;
        padding-left: 20px;
        font-size: 14px;
        color: var(--text-main);
      }
      .list li {
        margin-bottom: 4px;
      }
      .grid-2 {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 16px;
      }
      @media (min-width: 768px) {
        .grid-2 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      .card {
        background: var(--surface);
        border-radius: 8px;
        border: 1px solid var(--border);
        padding: 16px;
      }
      .card-meta {
        font-size: 11px;
        color: var(--text-muted);
      }
      .card-text {
        margin-top: 6px;
        font-size: 12px;
        color: var(--text-muted);
      }
      .section-intro {
        font-size: 13px;
        color: var(--text-muted);
        margin-bottom: 8px;
      }
      footer {
        border-top: 1px solid var(--border);
        padding-top: 12px;
        font-size: 11px;
        color: var(--text-muted);
      }
    </style>

    <!-- OG / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="Junseok Bae, MD, PhD" />
