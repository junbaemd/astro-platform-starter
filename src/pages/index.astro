---
const pageTitle =
  "Junseok Bae, MD – Endoscopic & Minimally Invasive Spine Surgeon";
const pageDescription =
  "Dr. Junseok Bae is a spine surgeon specializing in endoscopic lumbar, thoracic, and cervical (anterior and posterior) decompression, minimally invasive spine surgery, and adult spinal deformity surgery with SRS-based alignment goals.";
const siteUrl = "https://junspine.com";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={siteUrl} />

    <!-- 디자인 스타일 -->
    <style>
      :root {
        --bg: #0f172a;
        --bg-soft: #f3f4f6;
        --surface: #ffffff;
        --surface-soft: #f9fafb;
        --border: #e5e7eb;
        --border-soft: #e5e7f0;
        --text-main: #0f172a;
        --text-muted: #4b5563;
        --accent: #2563eb;
        --accent-soft: #dbeafe;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
        color: var(--text-main);
        background:
          radial-gradient(circle at top left, #1e293b 0, #020617 40%),
          linear-gradient(to bottom, #020617 260px, var(--bg-soft) 260px);
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }

      .page {
        max-width: 1100px;
        margin: 32px auto 40px;
        padding: 0 16px;
      }

      .shell {
        background: var(--surface);
        border-radius: 16px;
        box-shadow:
          0 18px 40px rgba(15, 23, 42, 0.22),
          0 0 0 1px rgba(148, 163, 184, 0.25);
        padding: 24px 22px 28px;
      }

      @media (min-width: 900px) {
        .shell {
          padding: 28px 32px 32px;
        }
      }

      header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
        border-bottom: 1px solid var(--border-soft);
        padding-bottom: 16px;
      }

      .brand-block {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .avatar {
        width: 40px;
        height: 40px;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--accent), #22c55e);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-weight: 700;
        font-size: 16px;
      }

      .brand-title {
        font-size: 18px;
        font-weight: 600;
      }

      .brand-sub {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 2px;
      }

      nav {
        background: var(--surface-soft);
        border-radius: 999px;
        padding: 4px 8px;
        border: 1px solid var(--border-soft);
      }

      nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 12px;
      }

      .nav-link {
        border-radius: 999px;
        padding: 4px 10px;
        color: var(--text-muted);
      }
      .nav-link:hover {
        background: var(--accent-soft);
        color: var(--accent);
      }

      h1 {
        font-size: 28px;
        margin: 0 0 4px;
      }
      h2 {
        font-size: 18px;
        margin: 0 0 10px;
        color: var(--text-muted);
        font-weight: 600;
      }
      h3 {
        font-size: 18px;
        margin: 0 0 10px;
        font-weight: 600;
      }
      h4 {
        font-size: 14px;
        margin: 0 0 8px;
        font-weight: 600;
      }
      p {
        font-size: 14px;
        line-height: 1.6;
        margin: 0;
      }

      .section {
        margin-bottom: 28px;
      }

      .section-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
        font-weight: 600;
        margin-bottom: 4px;
      }

      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
      }
      .chip {
        border-radius: 999px;
        border: 1px solid var(--border-soft);
        padding: 4px 12px;
        font-size: 11px;
        color: var(--text-muted);
        background: #f9fafb;
      }

      .list {
        margin: 0;
        padding-left: 20px;
        font-size: 14px;
      }
      .list li {
        margin-bottom: 4px;
      }

      .grid-2 {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 16px;
      }
      @media (min-width: 820px) {
        .grid-2 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .card {
        background: var(--surface-soft);
        border-radius: 12px;
        border: 1px solid var(--border-soft);
        padding: 14px 14px 16px;
      }
      .card-title {
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 4px;
      }
      .card-meta {
        font-size: 11px;
        color: var(--text-muted);
      }
      .card-text {
        margin-top: 6px;
        font-size: 12px;
        color: var(--text-muted);
      }

      .section-intro {
        font-size: 13px;
        color: var(--text-muted);
        margin-bottom: 8px;
      }

      footer {
        border-top: 1px solid var(--border-soft);
        padding-top: 10px;
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 8px;
      }
    </style>

    <!-- OG / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="Junseok Bae, MD, PhD" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

