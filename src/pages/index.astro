          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "@id": `${siteUrl}#faq`,
            mainEntity: [
              {
                "@type": "Question",
                name: "Which patients are candidates for anterior endoscopic cervical decompression?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text:
                    "Typical candidates are patients with cervical disc herniation or foraminal stenosis causing radiculopathy who have persistent symptoms despite conservative treatment, with pathology localized to a single or limited number of levels and without significant instability or deformity."
                }
              },
              {
                "@type": "Question",
                name:
                  "When is posterior endoscopic cervical foraminotomy preferred over anterior approaches?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text:
                    "Posterior endoscopic cervical foraminotomy is often preferred for lateral or foraminal stenosis in patients with preserved cervical alignment when motion preservation is desired and anterior pathology such as central disc herniation is limited."
                }
              },
              {
                "@type": "Question",
                name:
                  "What are the advantages of endoscopic thoracic decompression compared with open surgery?",
